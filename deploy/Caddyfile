# HTTPS-вход. Caddy сам получает и продлевает сертификаты для адресов ниже и передаёт запросы серверу Node.
# Копируется в /etc/caddy/Caddyfile (см. deploy/install.sh).
# Основной адрес — домен заказчика; unicorn-arena.emorozoff.ru — запасной, ведёт туда же.
bets.unicornfellowship.ru, unicorn-arena.emorozoff.ru {
	encode gzip
	reverse_proxy localhost:3000 {
		# Реалтайм-сигналы (SSE) должны уходить клиенту сразу, без буферизации
		flush_interval -1
	}
}
